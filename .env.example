# Copia questo file in .env (escluso da git) e compila i valori:  cp .env.example .env

# Connessione al database, come URL SQLAlchemy.
# Vuota = SQLite locale, nel file job_tracker.db alla root del progetto.
# Produzione su Supabase: Connect → Session pooler → URI, con la password del database:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Agente di scouting ---
# Chiave API Claude (https://platform.claude.com): valuta la pertinenza delle offerte.
ANTHROPIC_API_KEY=
# Adzuna (https://developer.adzuna.com): senza queste due chiavi la fonte viene saltata.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Bot Telegram: token da @BotFather e id della tua chat con il bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Punteggio minimo (0-100) perché un'offerta finisca nel report. Vuoto = 50.
SCOUT_MIN_SCORE=
